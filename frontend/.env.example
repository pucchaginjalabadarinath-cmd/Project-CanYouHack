VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "Publishable and
# secret API keys" tab, the one starting with sb_publishable_... (older
# projects may instead show a plain "anon" key - either works here, this
# variable just needs to hold whichever public client-side key your
# project shows you).
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Restrict signup to your college's email domain, e.g. "college.edu.in"
VITE_COLLEGE_EMAIL_DOMAIN=example.edu
