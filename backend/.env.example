# Postgres connection string from Supabase dashboard ->
# Project Settings -> Database -> Connection string (URI, use the
# "Session pooler" one for local dev)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Only needed once storage.py (ISSUES.md #5) is built - server-side file
# uploads use the secret key to bypass RLS, never expose this to the
# frontend. Get it from Supabase dashboard -> Project Settings -> API Keys
# -> "Publishable and secret API keys" tab (starts with sb_secret_...).
# If your project only shows legacy keys, use service_role instead.
SUPABASE_SECRET_KEY=your-secret-key-here

# Note: no JWT secret needed here. auth.py verifies tokens against the
# project's public JWKS endpoint (SUPABASE_URL + /auth/v1/.well-known/
# jwks.json) instead of a static shared secret - nothing to copy here.

# Hugging Face Space hosting the PolyCoder perplexity model (ISSUES.md #22).
# This is the Space's repo id (username/space-name), not a URL - the
# backend calls it via the gradio_client package. Only needed once
# perplexity_service.py (ISSUES.md #9) is built.
HF_SPACE_ID=your-username/your-space-name

# The frontend's local dev URL, for CORS. Change to your Vercel URL in prod.
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Only read by storage.py (ISSUES.md #5) when SUPABASE_URL or
# SUPABASE_SECRET_KEY above are NOT set - lets you build/test the
# assignments/submissions routers against local disk before the real
# Supabase Storage buckets exist. Ignored once both are set. Default if
# unset: ./local_storage
STORAGE_LOCAL_DIR=./local_storage